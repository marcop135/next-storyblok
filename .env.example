# Preview / draft token from Storyblok space Settings → Access Tokens
STORYBLOK_DELIVERY_API_TOKEN=

# eu | us | ap | ca | cn — match the space region
STORYBLOK_REGION=eu

# draft while building; published for production
STORYBLOK_VERSION=draft

# Shared secret for /api/preview?secret=…&slug=home
STORYBLOK_PREVIEW_SECRET=

# Shared secret for Storyblok publish webhook → /api/revalidate?secret=…
STORYBLOK_REVALIDATE_SECRET=
