{
  "name": "next-storyblok",
  "version": "0.4.1",
  "private": false,
  "description": "Next.js App Router + Storyblok marketing-site ownership demo (Northline)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
