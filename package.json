  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
